pipeline {
    agent any
    triggers { cron('H * * * *') }
    environment {
        RENOVATE_TOKEN = credentials('renovate-token-id')
        RENOVATE_PLATFORM = 'github'
    }
    stages {
        stage('Run Renovate') {
            steps { sh 'npx --yes renovate 13522049/RenovatePlayground' }
        }
    }
}